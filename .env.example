# -----------------------------------------------
# Plugin environment variables
# (used at runtime in your host Payload app)
# -----------------------------------------------

# Google Gemini API key (required if using Google models)
GOOGLE_AI_API=

# OpenAI API key (required if using OpenAI models)
OPENAI_API_KEY=

# Secret used to authenticate preview endpoint requests
PREVIEW_SECRET=your-preview-secret-here

# -----------------------------------------------
# Dev server variables
# (only needed when running the plugin's own dev server)
# -----------------------------------------------

# MongoDB connection string for the local dev database
DATABASE_URL=mongodb://127.0.0.1/payload-ai-generate-dev

# Optional: override the database name
DATABASE_NAME=payload-ai-generate-dev

# Payload secret key (any random string)
PAYLOAD_SECRET=your-payload-secret-here

# Public URL used by the Next.js dev server
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
