{
  "name": "payload-ai-generate",
  "version": "0.1.5-beta.3",
  "description": "AI generation plugin for Payload CMS",
  "homepage": "https://github.com/crazytweeks/payload-ai-generate",
  "repository": {
    "type": "git",
    "url": "https://github.com/crazytweeks/payload-ai-generate.git"
  },
  "keywords": [
    "payload",
    "payload-cms",
    "plugin",
    "ai",
    "generate",
    "llm"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./models": {
      "import": "./src/models.json",
      "types": "./src/models.json",
      "default": "./src/models.json"
    },
    "./models-types": {
      "import": "./src/models.ts",
      "types": "./src/models.ts",
      "default": "./src/models.ts"
    },
    "./client": {
      "import": "./src/exports/client.ts",
      "types": "./src/exports/client.ts",
      "default": "./src/exports/client.ts"
    },
    "./rsc": {
      "import": "./src/exports/rsc.ts",
      "types": "./src/exports/rsc.ts",
      "default": "./src/exports/rsc.ts"
    },
    "./preview": {
      "import": "./src/exports/rsc.ts",
      "types": "./src/exports/rsc.ts",
      "default": "./src/exports/rsc.ts"
    },
    "./blocks": {
      "import": "./src/exports/blocks.ts",
      "types": "./src/exports/blocks.ts",
      "default": "./src/exports/blocks.ts"
    },
    "./blocks/client": {
      "import": "./src/exports/blocks-client.ts",
      "types": "./src/exports/blocks-client.ts",
      "default": "./src/exports/blocks-client.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "prebuild": "bun run models:extract",
    "build": "bun run copyfiles",
    "build:types": "rm -f tsconfig.tsbuildinfo && tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "find src -type f \\( -name '*.json' -o -name '*.css' -o -name '*.scss' -o -name '*.html' -o -name '*.svg' -o -name '*.png' \\) | while IFS= read -r f; do d=\"dist/${f#src/}\"; mkdir -p \"$(dirname \"$d\")\"; cp \"$f\" \"$d\"; done",
    "devserver": "NODE_ENV=development PAYLOAD_AI_GENERATE_TEST_COLLECTIONS=true next dev dev --turbo -p 4000",
    "dev:generate-importmap": "bun run dev:payload generate:importmap",
    "dev:generate-types": "bun run dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "build:watch": "bun run build:swc --watch",
    "build:devserver": "cd dev && PAYLOAD_AI_GENERATE_TEST_COLLECTIONS=true next build",
    "start": "node dev/.next/standalone/apps/web/server.js",
    "start:bun": "bun run dev/.next/standalone/apps/web/server.js",
    "generate:importmap": "PAYLOAD_AI_GENERATE_TEST_COLLECTIONS=true bun run dev:generate-importmap",
    "generate:types": "PAYLOAD_AI_GENERATE_TEST_COLLECTIONS=true bun run dev:generate-types",
    "gen": "bun run generate:importmap && bun run generate:types",
    "models:extract": "bun run src/models-extract.ts",
    "lint": "bun biome lint .",
    "test": "vitest",
    "devtool": "NODE_ENV=development bunx @ai-sdk/devtools",
    "dev": "concurrently \"bun run devserver\" \"bun run devtool\"",
    "coolify-status": "bun ../../scripts/coolify/coolify.ts status-check payload-ai-generate"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.11",
    "@ai-sdk/google": "^4.0.37",
    "@ai-sdk/openai": "^4.0.34",
    "@ai-sdk/react": "^4.0.59",
    "@payloadcms/live-preview-react": "^3.87.1",
    "ai": "^7.0.56",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "^3.87.1",
    "@payloadcms/db-postgres": "^3.87.1",
    "@payloadcms/db-sqlite": "^3.87.1",
    "@payloadcms/next": "^3.87.1",
    "@payloadcms/richtext-lexical": "^3.87.1",
    "@payloadcms/ui": "^3.87.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "lucide-react": "^1.30.0",
    "next": "^16.2.10",
    "payload": "^3.87.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "payload": "^3.87.1"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "private": false
}
