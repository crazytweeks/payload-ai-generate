{
  "name": "payload-ai-generate",
  "version": "0.2.0-beta.1",
  "description": "AI generation plugin for Payload CMS",
  "homepage": "https://github.com/crazytweeks/payload-ai-generate",
  "repository": {
    "type": "git",
    "url": "https://github.com/crazytweeks/payload-ai-generate.git"
  },
  "keywords": [
    "payload",
    "payload-cms",
    "plugin",
    "ai",
    "generate",
    "llm"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "import": "./dist/models.json",
      "types": "./dist/models.json",
      "default": "./dist/models.json"
    },
    "./models-types": {
      "import": "./dist/models.js",
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "import": "./dist/exports/rsc.js",
      "types": "./dist/exports/rsc.d.ts",
      "default": "./dist/exports/rsc.js"
    },
    "./preview": {
      "import": "./dist/exports/rsc.js",
      "types": "./dist/exports/rsc.d.ts",
      "default": "./dist/exports/rsc.js"
    },
    "./blocks": {
      "import": "./dist/exports/blocks.js",
      "types": "./dist/exports/blocks.d.ts",
      "default": "./dist/exports/blocks.js"
    },
    "./blocks/client": {
      "import": "./dist/exports/blocks-client.js",
      "types": "./dist/exports/blocks-client.d.ts",
      "default": "./dist/exports/blocks-client.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "bun run models:extract",
    "build": "bun run build:types && bun run copyfiles",
    "build:types": "rm -f tsconfig.tsbuildinfo && tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "find src -type f \\( -name '*.json' -o -name '*.css' -o -name '*.scss' -o -name '*.html' -o -name '*.svg' -o -name '*.png' \\) | while IFS= read -r f; do d=\"dist/${f#src/}\"; mkdir -p \"$(dirname \"$d\")\"; cp \"$f\" \"$d\"; done",
    "devserver": "NODE_ENV=development PAYLOAD_AI_GENERATE_TEST_COLLECTIONS=true next dev dev --turbo -p 4000",
    "dev:generate-importmap": "bun run dev:payload generate:importmap",
    "dev:generate-types": "bun run dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "build:watch": "bun run build:swc --watch",
    "build:devserver": "cd dev && PAYLOAD_AI_GENERATE_TEST_COLLECTIONS=true next build",
    "start": "node dev/.next/standalone/apps/web/server.js",
    "start:bun": "bun run dev/.next/standalone/apps/web/server.js",
    "generate:importmap": "PAYLOAD_AI_GENERATE_TEST_COLLECTIONS=true bun run dev:generate-importmap",
    "generate:types": "PAYLOAD_AI_GENERATE_TEST_COLLECTIONS=true bun run dev:generate-types",
    "gen": "bun run generate:importmap && bun run generate:types",
    "models:extract": "bun run src/models-extract.ts",
    "lint": "bun biome lint .",
    "test": "vitest",
    "devtool": "NODE_ENV=development bunx @ai-sdk/devtools",
    "dev": "concurrently \"bun run devserver\" \"bun run devtool\"",
    "coolify-status": "bun ../../scripts/coolify/coolify.ts status-check payload-ai-generate"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.15",
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/openai": "^4.0.57",
    "@ai-sdk/react": "^4.0.94",
    "@payloadcms/live-preview-react": "^3.88.0",
    "ai": "^7.0.91",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "^3.88.0",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/db-sqlite": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "lucide-react": "^1.39.0",
    "next": "^16.3.4",
    "payload": "^3.88.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "payload": "^3.88.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "private": false
}
