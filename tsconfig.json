{
  "compilerOptions": {
    "customConditions": [
      "@nx-workspace-preview/source"
    ],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@plugin/*": [
        "./src/*"
      ]
    },
    "target": "es2022",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "composite": false,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "importHelpers": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUncheckedSideEffectImports": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dev"
  ]
}